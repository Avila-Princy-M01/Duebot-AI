# DueBot environment — copy to .env and fill in. Never commit real secrets.

# Database. Postgres for local/prod. Tests override this to SQLite automatically.
DATABASE_URL=postgresql+asyncpg://duebot:duebot@localhost:5432/duebot

# HTTP
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Anthropic (Claude Sonnet) or Gemini. Required for live reply parsing; mocked in tests.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Razorpay test-mode keys. Leave empty to use the mock Payment Links client.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook HMAC secret. REQUIRED — the webhook endpoint fails closed (503) if unset.
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp. Default is the in-process simulated inbox (demo-safe).
WHATSAPP_MODE=simulated
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Email fallback (optional SMTP). Empty = log-only stub.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=duebot@example.com

# Policy (named constants also live in engine/policy.py; env lets a merchant tune without a redeploy)
MAX_CONTACTS_PER_WEEK=3
CONFIDENCE_THRESHOLD=0.7

# Background poll loop (aging → promise → nudge → reply).
# Set to true to run the poller inside the FastAPI process (single-process demo).
# Leave false when running the separate `python -m backend.tasks.poller` worker.
ENABLE_POLLER=false

# Logging
LOG_LEVEL=INFO
